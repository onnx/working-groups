  use mach.int.Int32
  use export int.Int

  constant bits32 : int = 32
  clone export Wrap with constant bits = bits32

  type t = Int32.int32

  function to_int (x : t) : int = Int32.to_int x

  val constant czero : t
    ensures { to_int result = 0 }

  val function ( .+. ) (a b : t) : t
    ensures { to_int result = swrap (to_int a + to_int b) }

  val function ( .-. ) (a b : t) : t
    ensures { to_int result = swrap (to_int a - to_int b) }

  val function ( .*. ) (a b : t) : t
    ensures { to_int result = swrap (to_int a * to_int b) }

  val function ( .~. ) (a : t) : t
    ensures { to_int result = swrap (- to_int a) }

end

module WUInt32
  use mach.int.UInt32
  use export int.Int

  constant bits32 : int = 32
  clone export Wrap with constant bits = bits32

  type t = UInt32.uint32

  function to_int (x : t) : int = UInt32.to_int x

  val constant czero : t
    ensures { to_int result = 0 }

  val function ( .+. ) (a b : t) : t
    ensures { to_int result = uwrap (to_int a + to_int b) }

  val function ( .-. ) (a b : t) : t
    ensures { to_int result = uwrap (to_int a - to_int b) }

  val function ( .*. ) (a b : t) : t
    ensures { to_int result = uwrap (to_int a * to_int b) }

end
